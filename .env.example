# ==============================================================================
# GTOmniVid - 100% Always-Free Telegram Media Pipeline Environment Configuration
# ==============================================================================

# Telegram Credentials
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_ID=123456789

# GCP Free Tier 1 GB Egress Budget Guard (in MB)
# 900 MB hard cap preserves 100 MB safety buffer for bot signaling and API polling
EGRESS_HARD_CAP_MB=900
EGRESS_WARN_CAP_MB=850

# Fair Use Policy: Max successful downloads per user per 24 hours
USER_DAILY_QUOTA=3

# Storage Safety Parameters
# Minimum free space on disk volume in MB before accepting incoming jobs
MIN_FREE_DISK_MB=3000

# Concurrency Controller: Strictly 1 for 1 GB RAM e2-micro VM
CONCURRENCY_LIMIT=1

# Working Paths
SCRATCH_DIR=/tmp/tg_bot
DB_PATH=data/gtomnivid.db
COOKIES_FILE_PATH=config/cookies.txt

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
